# Секреты этого проекта. В git не попадает (см. .gitignore).
# Заполните и запускайте ./run.sh — переменные подхватятся сами.

# Токен бота от @BotFather (вида 123456789:AAE...)
TELEGRAM_BOT_TOKEN=

# Ваш chat id от @userinfobot. Для группы — отрицательное число.
TELEGRAM_CHAT_ID=

# --- необязательное, значения по умолчанию закомментированы ---
# TELEGRAM_DIGEST_AT=8,20        # часы отправки, местное время
# TELEGRAM_DIGEST_HOURS=12       # окно, за которое считается таблица
# TELEGRAM_AMOUNT_KZT=300000
# TELEGRAM_ROWS=5
# TELEGRAM_MIN_ORDERS=200
# TELEGRAM_MIN_RATE=97
# TELEGRAM_MIN_AD_FINISH=50
# TELEGRAM_TZ=Asia/Almaty
